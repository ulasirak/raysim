# raysim — Firebase yapılandırması (ŞABLON)
# Bu dosyayı .env.local olarak kopyalayıp değerleri kendi Firebase projenden doldur.
# Değerler: Firebase Console → Proje Ayarları → Uygulamalarınız (Web) → SDK yapılandırması.
# Not: NEXT_PUBLIC_* değerleri tarayıcıya gider (Firebase web config'i zaten geneldir);
# gerçek güvenlik Firestore Güvenlik Kuralları ile sağlanır.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Canlı alan adı (paylaşım kartları + mutlak URL'ler için). Örn: https://raysim.vercel.app
NEXT_PUBLIC_SITE_URL=

# Vitrin modu: "1" ise senaryolar SALT OKUNUR (Kaydet/Sil gizlenir).
# Canlıda (Vercel Production) 1 yap; yerelde senaryo düzenlerken boş bırak.
NEXT_PUBLIC_VITRIN=
