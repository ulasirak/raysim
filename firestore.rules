rules_version = '2';

// aslanray — Firestore güvenlik kuralları (VİTRİN + YÖNETİCİ GİRİŞİ)
// ────────────────────────────────────────────────────────────────
// Senaryolar HERKESE OKUNUR. Yazma/silme yalnız GİRİŞ YAPMIŞ YÖNETİCİYE açık.
// Yönetici = aşağıdaki e-postayla Email/Password ile giriş yapan kullanıcı.
// Ziyaretçi (anonim) veya başka bir hesap YAZAMAZ/SİLEMEZ.
//
// Kurulum (bir kez):
//   1) Firebase Console → Authentication → Sign-in method → Email/Password'ü ETKİNLEŞTİR.
//   2) Authentication → Users → Add user → e-posta = YONETICI_EPOSTA (aşağıdaki), şifre = seç.
//   3) Uygulamada Senaryolar panelinde "🔑 Yönetici girişi" ile o e-posta/şifreyle gir → Kaydet/Sil açılır.
// E-postayı değiştirmek istersen yalnız aşağıdaki satırı düzenle + `firebase deploy --only firestore:rules`.

service cloud.firestore {
  match /databases/{database}/documents {

    // Paylaşılan senaryo vitrini
    match /senaryolar/{doc} {
      allow read: if true;                                                   // herkes görüntüler/yükler
      allow write: if request.auth != null
                   && request.auth.token.email == "ulasirak073@gmail.com";   // yalnız yönetici yazar/siler
    }

    // Tanımlı olmayan her yol tamamen kapalı (varsayılan reddet)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
