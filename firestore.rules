rules_version = '2';

// raysim — Firestore güvenlik kuralları (ÇOK KİRACILI)
// ────────────────────────────────────────────────────────────────
// KRİTİK: Kiracı izolasyonunu YALNIZCA bu kurallar sağlar. İstemci sorgusu
// filtreliyor olsa bile yetkisiz okuma/yazma sunucuda reddedilir. Yeni bir
// koleksiyon eklerken buraya da kural yazılmalı (aksi halde varsayılan RED).
//
// Model:
//   projeler/{id} = { sahipUid, ad, veri(JSON), paylasim:{acik}, olusturma, guncelleme }
//   • Sahibi okur/yazar/siler.
//   • paylasim.acik == true ise link'i bilen HERKES yalnız OKUR (salt-okunur
//     sunum linki). Yazma asla açılmaz. Sahip kapatınca erişim anında kesilir.
//   • sahipUid oluşturulduktan sonra DEĞİŞTİRİLEMEZ (proje çalınamaz).
//
// Kurulum: Firebase Console → Authentication → Sign-in method → Email/Password
// ETKİN olmalı (self-servis kayıt bunu kullanır).
// Yayınlama: firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    function girisli() {
      return request.auth != null;
    }
    function sahip() {
      return girisli() && resource.data.sahipUid == request.auth.uid;
    }
    function paylasimaAcik() {
      return 'paylasim' in resource.data
             && 'acik' in resource.data.paylasim
             && resource.data.paylasim.acik == true;
    }

    // Kullanıcı projeleri (çok kiracılı)
    match /projeler/{id} {
      allow read: if sahip() || paylasimaAcik();

      allow create: if girisli()
                    && request.resource.data.sahipUid == request.auth.uid
                    && request.resource.data.ad is string
                    && request.resource.data.veri is string
                    && request.resource.data.veri.size() < 900000; // doküman sınırı payı

      allow update: if sahip()
                    && request.resource.data.sahipUid == resource.data.sahipUid // sahiplik sabit
                    && request.resource.data.veri is string
                    && request.resource.data.veri.size() < 900000;

      allow delete: if sahip();
    }

    // Eski paylaşılan senaryo vitrini (Sefer modülü anlık görüntüleri)
    match /senaryolar/{doc} {
      allow read: if true;
      allow write: if girisli()
                   && request.auth.token.email == "ulasirak073@gmail.com";
    }

    // Tanımlı olmayan her yol tamamen kapalı (varsayılan reddet)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
